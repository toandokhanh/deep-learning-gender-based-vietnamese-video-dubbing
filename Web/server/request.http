@baseUrl = http://localhost:5000/api
@accessToken = REPLACE_WITH_A_FRESH_LOGIN_TOKEN

### Current user
GET {{baseUrl}}/auth
Authorization: Bearer {{accessToken}}

### Login with an account created in your own local database
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"username":"demo-user","password":"REPLACE_WITH_YOUR_LOCAL_PASSWORD"}
